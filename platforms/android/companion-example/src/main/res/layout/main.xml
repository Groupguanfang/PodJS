<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F7F9FC" android:fillViewport="true">
    <LinearLayout android:orientation="vertical" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="PodJS Companion" android:textSize="28sp" android:textColor="#16324F" android:fontFamily="sans-serif-medium" android:accessibilityHeading="true" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/connection_status" android:text="尚未连接" android:accessibilityLiveRegion="polite" android:textSize="16sp" android:textColor="#1F5FA8" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="本机保存不代表已送达。同步使用配对密钥认证，但协议不加密内容；仅用非敏感演示数据。退到后台断开，离线数据保留。" android:textSize="14sp" android:textColor="#5D6C80" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/device" android:text="正在打开本机存储…" android:textSize="14sp" android:textColor="#5D6C80" android:textIsSelectable="true" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="目标设备" android:labelFor="@id/peer" android:textColor="#16324F" android:textSize="18sp" android:accessibilityHeading="true" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/peer" android:hint="设备 ID" android:singleLine="true" android:inputType="textNoSuggestions" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <Button android:id="@+id/refresh" android:text="查看该设备队列" android:textAllCaps="false" android:textColor="#1F5FA8" android:backgroundTint="#E5EDF7" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <TextView android:text="局域网连接" android:textColor="#16324F" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:accessibilityHeading="true" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="先在页面下方完成双方配对。一方监听，另一方连接其 IP 和端口；30 秒连接超时，本轮同步最多 120 秒，不自动重连。" android:textColor="#5D6C80" android:textSize="14sp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="本地绑定 IP / 对方 IP" android:labelFor="@id/ip" android:textColor="#16324F" android:textSize="16sp" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/ip" android:hint="监听用 0.0.0.0；连接填对方 IP" android:inputType="textNoSuggestions" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <TextView android:text="端口" android:labelFor="@id/port" android:textColor="#16324F" android:textSize="16sp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/port" android:text="38191" android:inputType="number" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <Button android:id="@+id/listen" android:text="等待此设备连接" android:textAllCaps="false" android:textColor="#1F5FA8" android:backgroundTint="#E5EDF7" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <Button android:id="@+id/connect" android:text="连接此设备" android:textAllCaps="false" android:textColor="@color/action_text" android:backgroundTint="@color/action_background" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <Button android:id="@+id/disconnect" android:text="断开连接" android:textAllCaps="false" android:textColor="#1F5FA8" android:backgroundTint="#E5EDF7" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <TextView android:text="BLE 独立连接" android:textColor="#16324F" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:accessibilityHeading="true" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="发现只提供蓝牙地址，不批准配对。先核对上方应用设备 ID 并在下方批准配对。一方广播等待，另一方扫描连接；等待方无需填写蓝牙地址。首条无线连接必须通过目标设备认证，失败即关闭。仅用非敏感测试数据。" android:textColor="#5D6C80" android:textSize="14sp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/ble_permissions" android:text="检查并请求蓝牙权限" android:textAllCaps="false" android:textColor="#1F5FA8" android:backgroundTint="#E5EDF7" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <Button android:id="@+id/ble_scan" android:text="扫描 PodJS 广播（5 秒）" android:textAllCaps="false" android:textColor="#1F5FA8" android:backgroundTint="#E5EDF7" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <Button android:id="@+id/ble_cancel" android:text="取消扫描" android:textAllCaps="false" android:textColor="#1F5FA8" android:backgroundTint="#E5EDF7" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <TextView android:id="@+id/ble_status" android:text="尚未扫描或连接 BLE" android:accessibilityLiveRegion="polite" android:textColor="#5D6C80" android:textSize="14sp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/ble_results" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="连接对方时的蓝牙地址" android:labelFor="@id/ble_address" android:textColor="#16324F" android:textSize="16sp" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/ble_address" android:hint="AA:BB:CC:DD:EE:FF" android:singleLine="true" android:inputType="textNoSuggestions" android:saveEnabled="false" android:maxLength="17" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <Button android:id="@+id/ble_connect" android:text="通过 BLE 连接并认证" android:textAllCaps="false" android:textColor="@color/action_text" android:backgroundTint="@color/action_background" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <Button android:id="@+id/ble_listen" android:text="广播并验证目标设备" android:textAllCaps="false" android:textColor="#1F5FA8" android:backgroundTint="#E5EDF7" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <TextView android:text="同步笔记" android:labelFor="@id/note" android:textColor="#16324F" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:accessibilityHeading="true" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/saved_note" android:text="尚未保存笔记" android:textColor="#5D6C80" android:textSize="14sp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/note" android:hint="写一条双端同步笔记" android:inputType="textMultiLine|textCapSentences" android:gravity="top" android:minLines="3" android:maxLines="5" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/save_note" android:text="保存到本机" android:textAllCaps="false" android:textColor="@color/action_text" android:backgroundTint="@color/action_background" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <TextView android:text="离线消息" android:labelFor="@id/message" android:textColor="#16324F" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:accessibilityHeading="true" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/message" android:hint="等待下次连接时发送的消息" android:inputType="textMultiLine|textCapSentences" android:minLines="2" android:maxLines="4" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/queue_message" android:text="加入离线队列" android:textAllCaps="false" android:textColor="@color/action_text" android:backgroundTint="@color/action_background" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <TextView android:id="@+id/queue" android:text="暂无待发送消息" android:textSize="14sp" android:textColor="#5D6C80" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="收到的待确认消息" android:textColor="#16324F" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:accessibilityHeading="true" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/inbox" android:orientation="vertical" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="文件传输" android:textColor="#16324F" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:accessibilityHeading="true" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="单文件最多 16 MiB。选择器离开页面会断开连接，选择完成后可手动重连。对方批准后，点击查询批准继续；不会自动批准或定时轮询。" android:textColor="#5D6C80" android:textSize="14sp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/choose_file" android:text="选择文件发送给目标设备" android:textAllCaps="false" android:textColor="@color/action_text" android:backgroundTint="@color/action_background" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <Button android:id="@+id/refresh_files" android:text="查询批准并继续" android:textAllCaps="false" android:textColor="#1F5FA8" android:backgroundTint="#E5EDF7" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <TextView android:text="发送给目标设备" android:textColor="#16324F" android:textSize="18sp" android:accessibilityHeading="true" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/outgoing_files" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="接收与本机批准" android:textColor="#16324F" android:textSize="18sp" android:accessibilityHeading="true" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:id="@+id/incoming_files" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/show_sources" android:text="查看与清理本机发送快照" android:textAllCaps="false" android:textColor="#1F5FA8" android:backgroundTint="#E5EDF7" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <LinearLayout android:id="@+id/sources" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="批准配对" android:textColor="#16324F" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:accessibilityHeading="true" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="先在上方填写对方设备 ID。一方生成随机密钥，通过可信线下渠道交给另一方；双方输入同一密钥并分别批准。密钥离开页面后清除，请勿截屏或记录到日志。" android:textColor="#5D6C80" android:textSize="14sp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="共享配对密钥" android:labelFor="@id/pairing_key" android:textColor="#16324F" android:textSize="16sp" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/pairing_key" android:hint="64 位十六进制字符" android:inputType="textVisiblePassword|textNoSuggestions" android:saveEnabled="false" android:importantForAutofill="noExcludeDescendants" android:imeOptions="flagNoPersonalizedLearning" android:maxLines="4" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <Button android:id="@+id/generate_key" android:text="生成随机密钥" android:textAllCaps="false" android:textColor="#1F5FA8" android:backgroundTint="#E5EDF7" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <Button android:id="@+id/approve_pairing" android:text="核对并批准配对" android:textAllCaps="false" android:textColor="@color/action_text" android:backgroundTint="@color/action_background" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <Button android:id="@+id/revoke_pairing" android:text="撤销目标设备配对" android:textAllCaps="false" android:textColor="#1F5FA8" android:backgroundTint="#E5EDF7" android:enabled="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
        <TextView android:id="@+id/result" android:accessibilityLiveRegion="polite" android:textSize="16sp" android:textColor="#16324F" android:layout_marginTop="20dp" android:layout_marginBottom="24dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
